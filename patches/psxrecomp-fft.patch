+/* Both horizontal edges must cover the viewport. A bounding box alone is
+ * insufficient: a sloping world polygon can leave a viewport corner exposed. */
+static inline int psx_wide_flat_overlay_covers(const int32_t *x, const int32_t *y,
+    int left, int top, int right, int bottom) {
+    return y[0] == y[1] && y[2] == y[3] && y[0] <= top && y[2] > bottom
+        && x[0] <= left && x[2] <= left && x[1] > right && x[3] > right;
+}
+
+/* Only an opaque, axis-aligned, full-draw-area vertical gradient is eligible.
+ * Exact bounds exclude dialog boxes and perspective-distorted world geometry.
+ * Vertices are the post-offset GP0 G4 order: TL, TR, BL, BR. */
+static inline int psx_wide_gradient_covers(const int32_t *x, const int32_t *y,
+    const uint32_t *rgb, int left, int top, int right, int bottom) {
+    return x[0] == x[2] && x[1] == x[3] && y[0] == y[1] && y[2] == y[3]
+        && x[0] <= left && x[1] > right && y[0] <= top && y[2] > bottom
+        && rgb[0] == rgb[1] && rgb[2] == rgb[3];
+}
