diff --git a/runtime/src/beetle_observe.cpp b/runtime/src/beetle_observe.cpp
new file mode 100644
--- /dev/null
+++ b/runtime/src/beetle_observe.cpp
@@ -0,0 +1,106 @@
+/* Bounded, observation-only CPU probes for the independent Beetle process. */
+#include <cstdint>
+#include <cstdio>
+#include "mednafen/psx/psx.h"
+
+namespace {
+constexpr uint32_t cycle_capacity = 4096;
+struct CycleHit { uint32_t pc; uint64_t cycles; };
+CycleHit cycle_hits[cycle_capacity];
+uint32_t anchor_raw, anchor_phys, end_raw, end_phys, max_hits, hits;
+bool armed, in_region;
+uint64_t region_start;
+
+void observe_instruction(uint32_t pc, uint64_t cycles) {
+    if (!armed) return;
+    const uint32_t phys = pc & 0x1fffffffu;
+    if (end_phys) {
+        if (!in_region) {
+            if (phys == anchor_phys) { region_start = cycles; in_region = true; }
+            return;
+        }
+        if (phys != end_phys) return;
+        cycles -= region_start;
+        in_region = false;
+    } else if (phys != anchor_phys) return;
+    cycle_hits[hits++] = {pc, cycles};
+    if (hits == max_hits) armed = false;
+}
+
+constexpr uint32_t exception_capacity = 512;
+struct ExceptionHit {
+    uint64_t sequence, cycles;
+    uint32_t code, pc, epc, sr, cause;
+};
+ExceptionHit exceptions[exception_capacity];
+uint64_t exception_total;
+
+void observe_exception(uint32_t code, uint32_t pc, uint32_t epc,
+                       uint32_t sr, uint32_t cause) {
+    const uint64_t seq = exception_total++;
+    exceptions[seq % exception_capacity] =
+        {seq, beetle_core_get_guest_cycles(), code, pc, epc, sr, cause};
+}
+}
+
+extern "C" void beetle_observe_init(void) {
+    armed = in_region = false;
+    hits = 0;
+    exception_total = 0;
+    g_psxrecomp_insn_cb = observe_instruction;
+    g_psxrecomp_exc_cb = observe_exception;
+}
+
+extern "C" void beetle_cyc_watch_arm(uint32_t start, uint32_t end, int n) {
+    anchor_raw = start; anchor_phys = start & 0x1fffffffu;
+    end_raw = end; end_phys = end & 0x1fffffffu;
+    max_hits = n > 0 ? (uint32_t)n : 16u;
+    if (max_hits > cycle_capacity) max_hits = cycle_capacity;
+    hits = 0; in_region = false; armed = true;
+}
+
+extern "C" void beetle_cyc_watch_clear(void) {
+    armed = in_region = false; hits = 0;
+}
+
+extern "C" void beetle_cyc_watch_get_state(uint32_t *ar, uint32_t *ap,
+    uint32_t *er, uint32_t *ep, uint32_t *limit, uint32_t *count, int *active) {
+    if (ar) *ar = anchor_raw;
+    if (ap) *ap = anchor_phys;
+    if (er) *er = end_raw;
+    if (ep) *ep = end_phys;
+    if (limit) *limit = max_hits;
+    if (count) *count = hits;
+    if (active) *active = armed;
+}
+
+extern "C" int beetle_cyc_watch_get(uint32_t i, uint32_t *index,
+    uint32_t *pc, unsigned long long *cycles) {
+    if (i >= hits) return 0;
+    if (index) *index = i;
+    if (pc) *pc = cycle_hits[i].pc;
+    if (cycles) *cycles = cycle_hits[i].cycles;
+    return 1;
+}
+
+extern "C" int retro_psxref_exc_ring_dump(char *out, int cap) {
+    if (!out || cap <= 0) return -1;
+    int pos = std::snprintf(out, (size_t)cap,
+        "{\"ok\":true,\"total\":%llu,\"entries\":[",
+        (unsigned long long)exception_total);
+    if (pos < 0 || pos >= cap) return -1;
+    uint64_t first = exception_total > exception_capacity
+        ? exception_total - exception_capacity : 0;
+    for (uint64_t i = first; i < exception_total; ++i) {
+        const auto &e = exceptions[i % exception_capacity];
+        int n = std::snprintf(out + pos, (size_t)(cap - pos),
+            "%s{\"seq\":%llu,\"cycles\":%llu,\"code\":%u,\"pc\":\"0x%08X\","
+            "\"epc\":\"0x%08X\",\"sr\":\"0x%08X\",\"cause\":\"0x%08X\"}",
+            i == first ? "" : ",", (unsigned long long)e.sequence,
+            (unsigned long long)e.cycles, e.code, e.pc, e.epc, e.sr, e.cause);
+        if (n < 0 || n >= cap - pos) return -1;
+        pos += n;
+    }
+    int n = std::snprintf(out + pos, (size_t)(cap - pos), "]}");
+    return n < 0 || n >= cap - pos ? -1 : pos + n;
+}
diff --git a/runtime/src/gpu_sw_attributes.h b/runtime/src/gpu_sw_attributes.h
new file mode 100644
--- /dev/null
+++ b/runtime/src/gpu_sw_attributes.h
@@ -0,0 +1,35 @@
+#ifndef PSX_GPU_SW_ATTRIBUTES_H
+#define PSX_GPU_SW_ATTRIBUTES_H
+
+#include <stdint.h>
+
+/* PS1 attribute planes: signed 12-fraction-bit derivatives, accumulated in
+ * wrapping 8.24 coordinates. Coverage edge rounding must never change UVs.
+ * Reference: Beetle mednafen/psx/gpu_polygon.cpp CalcIDeltas/DrawTriangle.
+ * Select the leftmost original vertex, with Beetle's exact tie ordering. */
+typedef struct { uint32_t base, dx, dy; } PSXAttribute;
+
+static inline PSXAttribute psx_attribute(int x0, int y0, int a0,
+                                        int x1, int y1, int a1,
+                                        int x2, int y2, int a2, int scale) {
+    int64_t den = (int64_t)(x1-x0)*(y2-y1) - (int64_t)(x2-x1)*(y1-y0);
+    PSXAttribute p = {0, 0, 0};
+    if (!den) return p;
+    int64_t nx = (int64_t)(a1-a0)*(y2-y1) - (int64_t)(a2-a1)*(y1-y0);
+    int64_t ny = (int64_t)(x1-x0)*(a2-a1) - (int64_t)(x2-x1)*(a1-a0);
+    p.dx = (uint32_t)(nx * 4096 / den) << 12;
+    p.dy = (uint32_t)(ny * 4096 / den) << 12;
+    int c = x1 <= x0 ? (x2 <= x1 ? 2 : 1) : (x2 < x0 ? 2 : 0);
+    int x = c == 0 ? x0 : c == 1 ? x1 : x2;
+    int y = c == 0 ? y0 : c == 1 ? y1 : y2;
+    int a = c == 0 ? a0 : c == 1 ? a1 : a2;
+    p.base = ((uint32_t)a << 24) + (uint32_t)(0x800000 / scale)
+           - p.dx * (uint32_t)x - p.dy * (uint32_t)y;
+    return p;
+}
+
+static inline uint32_t psx_attribute_at(PSXAttribute p, int x, int y) {
+    return p.base + p.dx * (uint32_t)x + p.dy * (uint32_t)y;
+}
+
+#endif
