+extern int beetle_gpu_probe(const uint32_t *words, unsigned count, uint16_t *pixels);
+static void h_gpu_probe(int id, const char *json) {
+    char input[1025];
+    uint32_t words[128];
+    uint16_t pixels[128 * 128];
+    if (!json_get_str(json, "words", input, sizeof(input))) {
+        send_err(id, "missing words"); return;
+    }
+    size_t n = strlen(input);
+    if (!n || n % 8) { send_err(id, "expected hexadecimal GP0 words"); return; }
+    for (size_t i = 0; i < n / 8; ++i) {
+        char word[9]; memcpy(word, input + i * 8, 8); word[8] = 0;
+        char *end; words[i] = (uint32_t)strtoul(word, &end, 16);
+        if (*end) { send_err(id, "invalid hexadecimal word"); return; }
+    }
+    if (!beetle_gpu_probe(words, (unsigned)(n / 8), pixels)) {
+        send_err(id, "GPU probe requires native scale and serializable core"); return;
+    }
+    char *hex = (char *)malloc(sizeof(pixels) * 2 + 1);
+    if (!hex) { send_err(id, "alloc"); return; }
+    for (int i = 0; i < 128 * 128; ++i) snprintf(hex + i * 4, 5, "%04x", pixels[i]);
+    send_fmt("{\"id\":%d,\"ok\":true,\"w\":128,\"h\":128,\"hex\":\"%s\"}\n", id, hex);
+    free(hex);
+}
