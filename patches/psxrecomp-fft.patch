+/* Isolated TCP GPU experiment. Restore the full core, including its FIFO and
+ * texture cache, before resuming. The procedural texture contains no game data. */
+extern "C" int beetle_gpu_probe(const uint32_t *words, unsigned count,
+                                 uint16_t *pixels) {
+    if (GPU_get_upscale_shift() != 0) return 0;
+    size_t size = retro_serialize_size();
+    void *state = malloc(size);
+    if (!state || !retro_serialize(state, size)) { free(state); return 0; }
+    GPU_Write(0, 4, 0x01000000);
+    for (unsigned a = 0; a < 1024 * 512; ++a) GPU_PokeRAM(a, 0);
+    for (unsigned v = 0; v < 256; ++v)
+        for (unsigned u = 0; u < 256; ++u)
+            GPU_PokeRAM(((v + 256) << 10) | (u + 512),
+                1 + ((u + v * 256) % 32767));
+    const uint32_t setup[] = {0x01000000, 0xe1000508, 0xe2000000,
+        0xe3000000, 0xe401fc7f, 0xe5000000, 0xe6000000};
+    for (uint32_t w : setup) { GPU.DrawTimeAvail = 1000000; GPU_WriteDMA(w, 0); }
+    for (unsigned i = 0; i < count; ++i) {
+        GPU.DrawTimeAvail = 1000000;
+        GPU_WriteDMA(words[i], 0);
+    }
+    for (unsigned y = 0; y < 128; ++y)
+        for (unsigned x = 0; x < 128; ++x)
+            pixels[y * 128 + x] = GPU_PeekRAM((y << 10) | x);
+    bool restored = retro_unserialize(state, size);
+    free(state);
+    if (!restored) abort(); // Never resume a guest with damaged diagnostic state.
+    return 1;
+}
