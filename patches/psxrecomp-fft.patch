diff --git a/runtime/tests/test_gpu_wide_gradient.c b/runtime/tests/test_gpu_wide_gradient.c
new file mode 100644
--- /dev/null
+++ b/runtime/tests/test_gpu_wide_gradient.c
@@ -0,0 +1,36 @@
+#include "gpu_wide_gradient.h"
+#include <stdio.h>
+
+#define CHECK(expr) do { if (!(expr)) { fprintf(stderr, "FAIL line %d\n", __LINE__); return 1; } } while (0)
+int main(void) {
+    /* Observed full-screen G4 geometry, expressed without any game assets. */
+    int32_t x[4] = {-128, 256, -128, 256};
+    int32_t y[4] = {240, 240, 480, 480};
+    uint32_t rgb[4] = {0x303830, 0x303830, 0x603830, 0x603830};
+    CHECK(psx_wide_gradient_covers(x, y, rgb, 0, 240, 255, 479));
+    /* A dialog, horizontal gradient, or projected world polygon must not
+     * replace the extra scenery with a sampled screen-edge color. */
+    y[0] = y[1] = 300;
+    CHECK(!psx_wide_gradient_covers(x, y, rgb, 0, 240, 255, 479));
+    y[0] = y[1] = 240;
+    rgb[1]++;
+    CHECK(!psx_wide_gradient_covers(x, y, rgb, 0, 240, 255, 479));
+    rgb[1]--;
+    x[3]--;
+    CHECK(!psx_wide_gradient_covers(x, y, rgb, 0, 240, 255, 479));
+    x[3]++;
+    x[1] = x[3] = 255;
+    CHECK(!psx_wide_gradient_covers(x, y, rgb, 0, 240, 255, 479));
+    /* The observed fade has a sloping left edge entirely outside the view. */
+    int32_t fx[4] = {0, 256, -128, 256};
+    int32_t fy[4] = {240, 240, 496, 496};
+    CHECK(psx_wide_flat_overlay_covers(fx, fy, 0, 240, 255, 479));
+    fx[0] = 1;
+    CHECK(!psx_wide_flat_overlay_covers(fx, fy, 0, 240, 255, 479));
+    fx[0] = 0; fx[2] = 1;
+    CHECK(!psx_wide_flat_overlay_covers(fx, fy, 0, 240, 255, 479));
+    fx[2] = -128; fy[3]--;
+    CHECK(!psx_wide_flat_overlay_covers(fx, fy, 0, 240, 255, 479));
+    puts("ALL PASS");
+    return 0;
+}
diff --git a/runtime/tests/test_gpu_wide_gradient_surface.py b/runtime/tests/test_gpu_wide_gradient_surface.py
new file mode 100644
--- /dev/null
+++ b/runtime/tests/test_gpu_wide_gradient_surface.py
@@ -0,0 +1,87 @@
+"""Check reveal rows against the rendered SSAA surface, including subrows."""
+import ctypes as c
+import sys
+
+
+def verify(lib, scale, base, band):
+    vram = (c.c_uint16 * (1024 * 512))()
+    lib.sw_renderer_init(vram)
+    lib.sw_renderer_set_scale(scale)
+    lib.sw_wide_configure(342, 43)
+    lib.sw_wide_set_target(base)
+    lib.sw_set_draw_area(base, band, base + 255, band + 239)
+    lib.sw_set_draw_offset(0, 0)
+    lib.sw_set_mask_bits(0, 0)
+    lib.sw_set_semi_transparency(0, 0)
+    lib.sw_wide_clear(base, 0, 512, 0x1234)
+    # A steep vertical gradient produces different values within a native row
+    # at SSAA 2/4, exposing native-row replication rather than subrow copying.
+    for y in range(band, band + 240, 8):
+        lib.sw_draw_gouraud_triangle(base, y, 0, base + 256, y, 0,
+                                    base, y + 8, 0x7fff)
+        lib.sw_draw_gouraud_triangle(base, y + 8, 0x7fff, base + 256, y, 0,
+                                    base + 256, y + 8, 0x7fff)
+    w, h, m = 342 * scale, 512 * scale, 43 * scale
+    before = (c.c_uint32 * (w * h))()
+    after = (c.c_uint32 * (w * h))()
+    native = (c.c_uint32 * (256 * scale * h))()
+    canonical_before = bytes(vram)
+    assert lib.sw_render_display_hires(native, 256 * scale * 4, base, 0, 256, 512) == len(native)
+    assert lib.sw_render_wide_display(before, w * 4, base, 0, 512) == len(before)
+    lib.sw_wide_extend_gradient(base, band, 240)
+    assert lib.sw_render_wide_display(after, w * 4, base, 0, 512) == len(after)
+    assert bytes(vram) == canonical_before
+    native_after = type(native)()
+    lib.sw_render_display_hires(native_after, 256 * scale * 4, base, 0, 256, 512)
+    assert bytes(native_after) == bytes(native)
+    for y in range(h):
+        a = list(after[y * w:(y + 1) * w])
+        b = list(before[y * w:(y + 1) * w])
+        if band * scale <= y < (band + 240) * scale:
+            assert a[:m] == [native[y * 256 * scale]] * m, (scale, base, band, y, 'left')
+            assert a[-m:] == [native[(y + 1) * 256 * scale - 1]] * m, (scale, base, band, y, 'right')
+            assert a[m:-m] == b[m:-m]
+        else:
+            assert a == b, (scale, base, band, y, 'other band')
+    if scale > 1:
+        assert any(native[y * 256 * scale] != native[(y + 1) * 256 * scale]
+                   for y in range(band * scale, (band + 8) * scale - 1) if y % scale != scale - 1)
+    # The fade is applied once over the wide surface only. Every blend mode
+    # must agree with the same backend's canonical rectangle, with no diagonal
+    # double blend and no writes into the other double-buffer band.
+    for mode in range(4):
+        lib.sw_set_semi_transparency(0, 0)
+        lib.sw_wide_disable_target()
+        lib.sw_fill_rect(base, band, 256, 240, 0x6318)
+        lib.sw_wide_set_target(base)
+        lib.sw_wide_clear(base, 0, 512, 0x1234)
+        lib.sw_wide_clear(base, band, 240, 0x6318)
+        lib.sw_wide_disable_target()
+        lib.sw_set_semi_transparency(1, mode)
+        lib.sw_draw_flat_rect(base, band, 256, 240, 0x2108)
+        lib.sw_render_display_hires(native, 256 * scale * 4, base, 0, 256, 512)
+        lib.sw_wide_set_target(base)
+        lib.sw_render_wide_display(before, w * 4, base, 0, 512)
+        saved = bytes(vram)
+        # Authored 256-high splash filters exceed the 240-row draw band.
+        lib.sw_wide_flat_overlay(band, 256, 0x2108)
+        assert bytes(vram) == saved
+        lib.sw_render_display_hires(native_after, 256 * scale * 4, base, 0, 256, 512)
+        assert bytes(native_after) == bytes(native)
+        lib.sw_render_wide_display(after, w * 4, base, 0, 512)
+        for y in range(h):
+            a = list(after[y * w:(y + 1) * w])
+            if band * scale <= y < (band + 240) * scale:
+                assert a == [native[y * 256 * scale]] * w, (scale, mode, y)
+            else:
+                assert a == list(before[y * w:(y + 1) * w])
+
+
+if __name__ == '__main__':
+    lib = c.CDLL(sys.argv[1])
+    lib.sw_renderer_init.argtypes = [c.POINTER(c.c_uint16)]
+    for scale in (1, 2, 4):
+        for base in (0, 256):
+            for band in (0, 240):
+                verify(lib, scale, base, band)
+    print('12 surface cases passed: scales 1/2/4, both buffer bands and bases; canonical and centre unchanged')
diff --git a/tools/build_beetle_oracle.ps1 b/tools/build_beetle_oracle.ps1
new file mode 100644
--- /dev/null
+++ b/tools/build_beetle_oracle.ps1
@@ -0,0 +1,64 @@
+[CmdletBinding()]
+param(
+    [string]$MsysRoot = 'C:\msys64',
+    [int]$Jobs = 8
+)
+$ErrorActionPreference = 'Stop'
+$frameworkRoot = Split-Path -Parent $PSScriptRoot
+$coreRoot = Join-Path $frameworkRoot 'beetle-psx'
+$pin = '5759277be50052b9f3f388578bf56cc7899d833f'
+$patch = Join-Path $frameworkRoot 'docs/beetle_oracle_hooks.patch'
+$mingw = Join-Path $MsysRoot 'mingw64'
+$bash = Join-Path $MsysRoot 'usr/bin/bash.exe'
+$cmake = Join-Path $mingw 'bin/cmake.exe'
+foreach ($required in @($bash, $cmake, (Join-Path $mingw 'bin/g++.exe'),
+                        (Join-Path $mingw 'include/zlib.h'),
+                        (Join-Path $mingw 'lib/pkgconfig/sdl2.pc'))) {
+    if (-not (Test-Path -LiteralPath $required)) { throw "Missing build dependency: $required" }
+}
+if ($Jobs -lt 1 -or $Jobs -gt 64) { throw 'Jobs must be in 1..64' }
+$oldPath = $env:PATH
+try {
+    $env:PATH = (Join-Path $mingw 'bin') + ';' + $env:PATH
+    if (-not (Test-Path -LiteralPath $coreRoot)) {
+        git clone https://github.com/libretro/beetle-psx-libretro.git $coreRoot
+        if ($LASTEXITCODE -ne 0) { throw 'Beetle clone failed' }
+        git -C $coreRoot checkout --detach $pin
+        if ($LASTEXITCODE -ne 0) { throw 'Beetle checkout failed' }
+    }
+    $actual = (git -C $coreRoot rev-parse HEAD).Trim()
+    if ($actual -ne $pin) { throw "Beetle checkout must be pinned at $pin; found $actual. Existing files were preserved." }
+    $alreadyPatched = $false
+    try {
+        git -C $coreRoot apply --reverse --check $patch 2>$null
+        $alreadyPatched = $LASTEXITCODE -eq 0
+    } catch {
+        # Windows PowerShell can turn the expected reverse-check stderr into
+        # a NativeCommandError. The forward check below decides applicability.
+        $alreadyPatched = $false
+    }
+    if (-not $alreadyPatched) {
+        git -C $coreRoot apply --check $patch
+        if ($LASTEXITCODE -ne 0) { throw 'Oracle patch conflicts with the existing tree; no changes applied' }
+        git -C $coreRoot apply $patch
+        if ($LASTEXITCODE -ne 0) { throw 'Oracle patch failed' }
+    }
+    Push-Location $coreRoot
+    try {
+        & $bash -c "export PATH=/mingw64/bin:/usr/bin:`$PATH; /usr/bin/make -s platform=mingw_x86_64 STATIC_LINKING=1 HAVE_LIGHTREC=0 -j$Jobs"
+        if ($LASTEXITCODE -ne 0) { throw 'Beetle static-library build failed' }
+        Copy-Item -LiteralPath 'mednafen_psx_libretro.dll' -Destination 'libmednafen_psx.a'
+    } finally { Pop-Location }
+    $build = Join-Path $frameworkRoot 'runtime/build-oracle'
+    & $cmake -S (Join-Path $frameworkRoot 'runtime') -B $build -G Ninja `
+        -DCMAKE_BUILD_TYPE=RelWithDebInfo -DPSX_DEBUG_TOOLS=ON `
+        -DPSX_RECOMP_UI=OFF -DPSX_REWIND=OFF -DPSX_NETPLAY=OFF `
+        -DPSXRECOMP_ALLOW_NO_BIOS=ON -DBUILD_TESTING=OFF `
+        -DPSX_SDL_BACKEND=SDL2 -DPSX_ENABLE_VULKAN=OFF -DPSX_DEPS_OFFLINE=ON `
+        -DCMAKE_C_COMPILER_LAUNCHER= -DCMAKE_CXX_COMPILER_LAUNCHER= `
+        "-DZLIB_INCLUDE_DIR=$mingw/include" "-DZLIB_LIBRARY=$mingw/lib/libz.a"
+    if ($LASTEXITCODE -ne 0) { throw 'Oracle CMake configuration failed' }
+    & $cmake --build $build --target psx-beetle "-j$Jobs"
+    if ($LASTEXITCODE -ne 0) { throw 'Oracle executable build failed' }
+    Write-Output (Join-Path $build 'psx-beetle.exe')
+} finally { $env:PATH = $oldPath }
diff --git a/tools/verify_beetle_oracle.py b/tools/verify_beetle_oracle.py
new file mode 100644
--- /dev/null
+++ b/tools/verify_beetle_oracle.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+"""Verify a running oracle using real TCP observations; writes summary JSON.
+
+Keep --out under a gitignored build directory. Screenshots and audio created
+alongside it remain local. --anchor and --end must name observed executable
+addresses in the running program, not guessed function seeds.
+"""
+import argparse
+import hashlib
+import json
+import socket
+import time
+import wave
+from pathlib import Path
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--port', type=int, default=4380)
+    ap.add_argument('--bios', type=Path, required=True)
+    ap.add_argument('--anchor', required=True)
+    ap.add_argument('--end', required=True)
+    ap.add_argument('--out', type=Path, required=True)
+    args = ap.parse_args()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    result = {'status': 'running', 'port': args.port}
+
+    def call(cmd, **kwargs):
+        with socket.create_connection(('127.0.0.1', args.port), 5) as sock:
+            sock.settimeout(10)
+            sock.sendall((json.dumps(dict(cmd=cmd, id=1, **kwargs)) + '\n').encode())
+            response = json.loads(sock.makefile('rb').readline())
+        if not response.get('ok'):
+            raise RuntimeError(f'{cmd}: {response}')
+        return response
+
+    def collect_cycles(**kwargs):
+        call('cyc_watch', pc=args.anchor, n=8, **kwargs)
+        deadline = time.monotonic() + 8
+        while True:
+            data = call('cyc_watch_dump')
+            if data['hits'] == 8:
+                assert len(data['entries']) == 8 and not data['armed']
+                return data
+            if time.monotonic() >= deadline:
+                raise RuntimeError('cycle anchor did not execute eight times')
+            time.sleep(.1)
+
+    try:
+        first = call('ping')
+        assert first['backend'] == 'beetle'
+        result['first'] = first
+        actual = bytes.fromhex(call('read_ram', addr='0x1FC00000', len=524288)['hex'])
+        assert actual == args.bios.read_bytes(), 'loaded BIOS differs from requested image'
+        result['bios_sha256'] = hashlib.sha256(actual).hexdigest()
+        result['single'] = collect_cycles()
+        samples = [x['cycles'] for x in result['single']['entries']]
+        assert all(b > a for a, b in zip(samples, samples[1:]))
+        result['region'] = collect_cycles(end=args.end)
+        assert all(e['cycles'] > 0 for e in result['region']['entries'])
+        call('cyc_watch_clear')
+        cleared = call('cyc_watch_dump')
+        assert cleared['hits'] == 0 and not cleared['armed']
+        call('fntrace_unfiltered', on=1)
+        call('devtrace_ctl', reset=1, arm=1)
+        call('set_input', buttons='0xFFFF')
+        time.sleep(.3)
+        pad = call('pad_status')
+        assert pad['override'] == 65535 and pad['pad'] == '0xFFFF'
+        call('clear_input')
+        assert call('pad_status')['override'] == -1
+        for cmd in ('wtrace_dump', 'rtrace_dump', 'fntrace_dump', 'sio_trace',
+                    'cdrom_cmd_dump', 'spu_events', 'devtrace_dump', 'exc_ring'):
+            data = call(cmd, count=8)
+            entries = data.get('entries', data.get('events', []))
+            assert entries and data['total'] > 0, f'{cmd} contains no observations'
+            result[cmd] = {'total': data['total'], 'sample_count': len(entries)}
+        result['cdc_volume'] = call('cdc_volume')
+        shot = args.out.with_suffix('.png').resolve()
+        result['screenshot'] = call('screenshot', path=shot.as_posix())
+        assert shot.read_bytes().startswith(b'\x89PNG\r\n\x1a\n')
+        audio = args.out.with_suffix('.wav').resolve()
+        result['audio'] = call('audio_wav', path=audio.as_posix(), count=44100)
+        with wave.open(str(audio)) as stream:
+            assert stream.getnchannels() == 2 and stream.getframerate() == 44100
+            assert stream.getnframes() == 44100
+        final = call('ping')
+        assert final['frame'] > first['frame'] and final['guest_cycles'] > first['guest_cycles']
+        result['last'] = final
+        result['cycles_per_frame'] = (final['guest_cycles'] - first['guest_cycles']) / (final['frame'] - first['frame'])
+        result['status'] = 'passed'
+    except Exception as exc:
+        result['status'] = 'failed'
+        result['error'] = str(exc)
+        raise
+    finally:
+        args.out.write_text(json.dumps(result, indent=2) + '\n')
+    print(json.dumps({'status': result['status'], 'proof': str(args.out),
+                      'cycles_per_frame': result['cycles_per_frame']}))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/verify_gpu_raster.py b/tools/verify_gpu_raster.py
new file mode 100644
--- /dev/null
+++ b/tools/verify_gpu_raster.py
@@ -0,0 +1,97 @@
+"""Compare the real software rasterizer with Beetle's TCP GPU probe.
+
+The DLL is built from gpu_sw_renderer.c, gpu_vram_dirty.c and
+runtime/tests/gpu_sw_probe_support.c. No guest assets or generated code.
+"""
+import argparse
+import ctypes as C
+import itertools
+import hashlib
+import json
+import random
+import socket
+import struct
+
+
+def query(port, words):
+    with socket.create_connection(('127.0.0.1', port), timeout=30) as s:
+        s.sendall((json.dumps({'id': 1, 'cmd': 'gpu_probe',
+                              'words': ''.join(f'{w:08x}' for w in words)})+'\n').encode())
+        r = json.loads(s.makefile('rb').readline())
+    if not r.get('ok'):
+        raise RuntimeError(r)
+    return [int(r['hex'][i:i+4], 16) for i in range(0, len(r['hex']), 4)]
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('dll')
+    ap.add_argument('--port', type=int, default=4380)
+    ap.add_argument('--output')
+    ap.add_argument('--reference', help='Previously captured Beetle hashes; offline regression')
+    args = ap.parse_args()
+    sw = C.CDLL(args.dll)
+    ram = (C.c_uint16 * (1024 * 512))()
+    cases = []
+    for tri in [((7, 9, 4, 8), (81, 18, 98, 3), (17, 92, 12, 104)),
+                ((12, 12, 0, 0), (108, 12, 95, 0), (12, 108, 0, 95)),
+                ((19, 91, 250, 5), (23, 8, 0, 250), (100, 91, 5, 5))]:
+        cases.extend(itertools.permutations(tri))
+    rng = random.Random(94221)
+    for _ in range(40):
+        cases.append(tuple((rng.randrange(-20, 148), rng.randrange(-20, 148),
+                            rng.randrange(256), rng.randrange(256)) for _ in range(3)))
+    results = []
+    reference = None
+    if args.reference:
+        from pathlib import Path
+        reference = json.loads(Path(args.reference).read_text(encoding='utf-8'))['results']
+    for shaded in (False, True):
+        for index, tri in enumerate(cases):
+            C.memset(ram, 0, C.sizeof(ram))
+            for v in range(256):
+                for u in range(256):
+                    ram[(v+256)*1024+u+512] = 1+(u+v*256)%32767
+            sw.sw_renderer_init(ram)
+            sw.sw_set_draw_area(0, 0, 127, 127)
+            sw.sw_set_color_modulation(128, 128, 128, 1)
+            words = [0x35000000 if shaded else 0x25000000]
+            call = []
+            for i, (x, y, u, v) in enumerate(tri):
+                if shaded and i: words.append(0)
+                words += [(x & 65535) | ((y & 65535) << 16),
+                          u | (v << 8) | (0x118 << 16 if i == 1 else 0)]
+                call += [x, y, u, v]
+                if shaded: call.append(0)
+            if shaded:
+                sw.sw_draw_shaded_textured_triangle(*call, 0, 0, 0x118, 1)
+            else:
+                sw.sw_draw_textured_triangle(*call, 0, 0, 0x118)
+            native = [ram[y*1024+x] for y in range(128) for x in range(128)]
+            digest = hashlib.sha256(struct.pack('<16384H', *native)).hexdigest()
+            if reference is None:
+                oracle = query(args.port, words)
+                expected = hashlib.sha256(struct.pack('<16384H', *oracle)).hexdigest()
+                mismatch = sum(a != b for a, b in zip(native, oracle))
+            else:
+                item = reference[len(results)]
+                assert item['vertices'] == [list(v) for v in tri]
+                assert item['shaded_raw'] == shaded
+                expected = item['beetle_sha256']
+                mismatch = int(digest != expected)
+            results.append({'case': index, 'shaded_raw': shaded, 'vertices': tri,
+                            'different_pixels': mismatch, 'native_sha256': digest,
+                            'beetle_sha256': expected})
+    report = {'cases': len(results), 'failed': sum(r['different_pixels'] != 0 for r in results),
+              'different_pixels': sum(r['different_pixels'] for r in results),
+              'comparison': 'hashes' if reference is not None else 'pixels',
+              'beetle_commit': '5759277be50052b9f3f388578bf56cc7899d833f', 'results': results}
+    if args.output:
+        from pathlib import Path
+        Path(args.output).write_text(json.dumps(report, indent=2)+'\n', encoding='utf-8')
+    print(json.dumps({k: v for k, v in report.items() if k != 'results'}))
+    return int(report['failed'] != 0)
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
